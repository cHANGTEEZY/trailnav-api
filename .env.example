PORT=3000
NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0

CORS_ORIGIN=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
MOBILE_APP_SCHEME=trailnav://

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trailnav
# DATABASE_URL_UNPOOLED=  # optional direct connection URL for Neon migrations

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

# Get your key from https://app.arcjet.com
ARCJET_KEY=ajkey_your_key_here
ARCJET_ENV=development

# Regional offline tile pack CDN base URL
PACK_CDN_BASE_URL=https://packs.trailnav.np/v1

# Optional Cloudflare R2 credentials for presigned media uploads
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=trailnav-media
# R2_PUBLIC_BASE_URL=https://media.trailnav.np
# R2_PRESIGN_EXPIRY_SECONDS=900
